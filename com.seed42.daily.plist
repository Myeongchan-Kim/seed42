<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.seed42.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mckim/projects/number/run_daily.sh</string>
    <string>3</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mckim/projects/number</string>
  <!-- 매일 03:00. 자고 있었으면 깨어난 뒤 한 번 실행된다 (cron 은 건너뛴다) -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/mckim/projects/number/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/mckim/projects/number/logs/launchd.err</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
